#include <stdio.h>
#include <conio.h>
int main()
{
    int i=1;
    clrscr();
    printf("Numbers using for loop:\n");
    for(i=1;i<=10;i++)
    {
        printf("%d",i);
    }
    printf("numbers using while loop:");
    while(i<=10)
    {
        printf("%d",i);
        i++;
    }
    printf("numbers using do while loop:");
    do
    {
printf("d",i);
i++
    }while(i<=10);
    getch();
    return 0;
}